{
  "name": "blazefire",
  "version": "1.0.0",
  "description": "Blazefire framework powered by Frostfast compiler",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "require": "./src/compiler/index.js",
      "types": "./dist/compiler/index.d.ts"
    },
    "./styles": "./assets/blazefire-global.css",
    "./components/*": "./src/components/*"
  },
  "files": [
    "index.js",
    "src/",
    "dist/",
    "README.md",
    "assets/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blazefire",
    "framework",
    "react",
    "error-overlay",
    "devtools",
    "cyberpunk",
    "neon",
    "compiler",
    "frostfast",
    "swc",
    "turbopack"
  ],
  "author": "Blazefire Team",
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^6.0.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blazefire/blazefire.git"
  },
  "bugs": {
    "url": "https://github.com/blazefire/blazefire/issues"
  },
  "homepage": "https://blazefire.dev"
}
