{
  "name": "blazefire",
  "version": "2.0.0",
  "description": "BlazeFire v2 — a pure App Router, Turbopack/Frostfast-first React framework runtime",
  "type": "module",
  "license": "MIT",
  "bin": {
    "blazefire": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "default": "./dist/branding.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./runtime/inject": {
      "types": "./dist/runtime/inject.d.ts",
      "default": "./dist/runtime/inject.js"
    }
  },
  "files": [
    "dist",
    "blazefire-logo.png",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "generate": "node scripts/generate-logo-data.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run generate && jest",
    "clean": "rm -rf dist src/generated"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
