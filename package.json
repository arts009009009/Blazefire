{
  "name": "blazefire",
  "version": "1.0.0",
  "description": "Blazefire framework powered by Frostfast compiler",
  "main": "blazefire/index.js",
  "types": "blazefire/dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./blazefire/dist/index.js",
      "require": "./blazefire/index.js",
      "types": "./blazefire/dist/index.d.ts"
    },
    "./compiler": {
      "import": "./blazefire/dist/compiler/index.js",
      "require": "./blazefire/src/compiler/index.js",
      "types": "./blazefire/dist/compiler/index.d.ts"
    },
    "./styles": "./blazefire/assets/blazefire-global.css",
    "./components/*": "./blazefire/src/components/*"
  },
  "files": [
    "blazefire/index.js",
    "blazefire/src/",
    "blazefire/dist/",
    "blazefire/assets/",
    "blazefire/README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blazefire",
    "framework",
    "react",
    "error-overlay",
    "devtools",
    "cyberpunk",
    "neon",
    "compiler",
    "frostfast",
    "swc",
    "turbopack"
  ],
  "author": "Blazefire Team",
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^6.0.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arts009009009/blazefire.git"
  },
  "bugs": {
    "url": "https://github.com/arts009009009/blazefire/issues"
  },
  "homepage": "https://blazefire.dev"
}
