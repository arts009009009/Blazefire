{
  "name": "blazefire",
  "version": "1.1.1",
  "description": "Blazefire framework powered by Frostfast compiler",
  "type": "module",
  "main": "blazefire/index.js",
  "types": "blazefire/src/index.tsx",
  "exports": {
    ".": {
      "types": "./blazefire/src/index.tsx",
      "default": "./blazefire/index.js"
    },
    "./package.json": "./package.json",
    "./plugin": {
      "types": "./blazefire/plugin.d.ts",
      "default": "./blazefire/plugin.cjs"
    },
    "./branding": {
      "types": "./blazefire/branding.d.ts",
      "default": "./blazefire/branding.cjs"
    },
    "./compiler": {
      "types": "./blazefire/src/compiler/index.ts",
      "default": "./blazefire/src/compiler/index.js"
    },
    "./styles": "./blazefire/assets/blazefire-global.css",
    "./components/*": {
      "types": "./blazefire/src/components/*.tsx",
      "default": "./blazefire/src/components/*.js"
    },
    "./data/*": "./blazefire/data/*"
  },
  "bin": {
    "blazefire": "./blazefire/cli.cjs"
  },
  "files": [
    "blazefire/index.js",
    "blazefire/utils.js",
    "blazefire/provider.js",
    "blazefire/plugin.cjs",
    "blazefire/plugin.d.ts",
    "blazefire/branding.cjs",
    "blazefire/branding.d.ts",
    "blazefire/logo-data.cjs",
    "blazefire/build-logo-data.cjs",
    "blazefire/runtime/",
    "blazefire/src/",
    "blazefire/assets/",
    "blazefire/data/",
    "blazefire/postinstall.cjs",
    "blazefire/update-check.cjs",
    "blazefire/cli.cjs",
    "blazefire/README.md"
  ],
  "scripts": {
    "postinstall": "node blazefire/postinstall.cjs",
    "build": "node blazefire/build-logo-data.cjs && tsc",
    "build:logo": "node blazefire/build-logo-data.cjs",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "blazefire:dev": "echo 'Blazefire dev mode — use next dev from your project'"
  },
  "keywords": [
    "blazefire",
    "framework",
    "react",
    "error-overlay",
    "devtools",
    "cyberpunk",
    "neon",
    "compiler",
    "frostfast",
    "swc",
    "turbopack"
  ],
  "author": "Blazefire Team",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arts009009009/Blazefire.git"
  },
  "bugs": {
    "url": "https://github.com/arts009009009/Blazefire/issues"
  },
  "homepage": "https://blazefire.dev"
}
