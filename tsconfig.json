{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext"
  },
  // The package only ships `blazefire/**` (see package.json "files"/"exports"),
  // so only that tree is compiled. `blazefire/src/**` is the types source for
  // the shipped runtime (index.js / provider.js / components/*.js).
  "include": ["blazefire/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
