{
  // Debug configurations for THIS repository (the Blazefire framework).
  //
  // Note: an earlier version of this file was copied from the vercel/next.js
  // monorepo and launched `packages/next/dist/bin/next` against
  // `examples/hello-world`. Neither exists here — `packages/next/` is a stub
  // tree with no built `dist/`, and there is no `examples/` directory — so
  // every launch failed with MODULE_NOT_FOUND. These configs target what the
  // repo actually ships: the Blazefire CLI and the jest suites.
  "version": "0.2.0",
  "inputs": [
    {
      "id": "cliCommand",
      "type": "pickString",
      "description": "Select a blazefire CLI command to debug",
      "options": [
        "init",
        "restore",
        "check",
        "update",
        "--help",
        "--version"
      ],
      "default": "init"
    }
  ],
  "configurations": [
    {
      // Debugs the real CLI entry (blazefire/cli.cjs). Runs against the
      // directory of the currently open file — open a file inside a fixture
      // app first when debugging `init`/`restore`; `--help`/`--version`/
      // `check`/`update` work from anywhere. With no file open this falls
      // back to the workspace root, where `init` correctly no-ops (ownRoot
      // guard — blazefire never edits its own package).
      "name": "Debug blazefire CLI",
      "type": "node",
      "request": "launch",
      "cwd": "${fileDirname}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["${workspaceFolder}/blazefire/cli.cjs", "${input:cliCommand}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    {
      // Debugs whichever test file is currently open in the editor.
      "name": "Debug current jest test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/jest/bin/jest.js",
        "--runInBand",
        "--verbose",
        "${file}"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Attach to an already-running `node --inspect` process.
      "type": "node",
      "request": "attach",
      "name": "Attach to existing debugger (port 9229)",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
