{
  "name": "blazefire",
  "version": "1.0.0",
  "description": "Blazefire framework powered by Frostfast compiler",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "require": "./src/compiler/index.js",
      "types": "./dist/compiler/index.d.ts"
    },
    "./styles": "./assets/blazefire-global.css",
    "./components/*": "./src/components/*",
    "./data/*": "./data/*"
  },
  "files": [
    "index.js",
    "src/",
    "dist/",
    "assets/",
    "data/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blazefire",
    "framework",
    "react",
    "nextjs",
    "error-overlay",
    "devtools",
    "cyberpunk",
    "compiler"
  ],
  "author": "Blazefire Team",
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
